--// Helpers
local function new(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do
		o[k] = v
	end
	o.Parent = parent
	return o
end

local function makeBtn(text, parent, y, height)
	return new("TextButton", {
		Size = UDim2.new(1, 0, 0, height or 24),
		Position = UDim2.new(0, 0, 0, y),
		BackgroundColor3 = BG2,
		TextColor3 = TXT,
		Text = text,
		Font = Enum.Font.Gotham,
		TextSize = 12,
		BorderSizePixel = 0,
		AutoButtonColor = false,
	}, parent)
end

local function paint(b, on, label)
	b.BackgroundColor3 = on and Color3.fromRGB(0, 100, 75) or BG2
	b.Text = label
end

local function makeToggle(parent, label, y, initial, onChange)
	local b = makeBtn(label .. ": " .. (initial and "ON" or "OFF"), parent, y)
	paint(b, initial, label .. ": " .. (initial and "ON" or "OFF"))
	local state = initial
	b.MouseButton1Click:Connect(function()
		state = not state
		paint(b, state, label .. ": " .. (state and "ON" or "OFF"))
		onChange(state)
	end)
	return b
end

local function makeSlider(parent, label, value, y, apply)
	local lbl = new("TextLabel", {
		Size = UDim2.new(1, -8, 0, 14),
		Position = UDim2.new(0, 4, 0, y),
		BackgroundTransparency = 1,
		Text = label .. ": " .. value,
		TextXAlignment = Enum.TextXAlignment.Left,
		Font = Enum.Font.Gotham,
		TextSize = 11,
		TextColor3 = Color3.fromRGB(170, 185, 182),
	}, parent)

	local box = new("TextBox", {
		Size = UDim2.new(0, 58, 0, 20),
		Position = UDim2.new(1, -62, 0, y - 2),
		BackgroundColor3 = BG2,
		TextColor3 = TXT,
		Font = Enum.Font.Gotham,
		TextSize = 12,
		Text = tostring(value),
		BorderSizePixel = 0,
		ClearTextOnFocus = false,
	}, parent)

	box.FocusLost:Connect(function()
		local n = tonumber(box.Text)
		if n then
			local v = apply(n)
			lbl.Text = label .. ": " .. v
			box.Text = tostring(v)
		else
			box.Text = tostring(value)
		end
	end)
end

