--// ESP
local espData = {}

local function mkDraw(kind, props)
	local ok, obj = pcall(function()
		local o = Drawing.new(kind)
		o.Visible = false
		for k, v in pairs(props) do
			o[k] = v
		end
		return o
	end)
	return ok and obj or nil
end

local function createESP(plr)
	if plr == LP or espData[plr] then return end
	espData[plr] = {
		box = mkDraw("Square", { Color = TEAL, Thickness = 1, Filled = false }),
		name = mkDraw("Text", { Color = TEAL, Size = 13, Center = true, Outline = true, OutlineColor = Color3.new(0, 0, 0) }),
		dist = mkDraw("Text", { Color = TEAL, Size = 12, Center = true, Outline = true, OutlineColor = Color3.new(0, 0, 0) }),
		tool = mkDraw("Text", { Color = GOLD, Size = 12, Center = true, Outline = true, OutlineColor = Color3.new(0, 0, 0) }),
		tracer = mkDraw("Line", { Color = TEAL, Thickness = 1 }),
		arrow1 = mkDraw("Line", { Color = GOLD, Thickness = 2 }),
		arrow2 = mkDraw("Line", { Color = GOLD, Thickness = 2 }),
	}
end

local function destroyESP(plr)
	local d = espData[plr]
	if not d then return end
	for _, o in pairs(d) do
		if o then pcall(function() o:Remove() end) end
	end
	espData[plr] = nil
end

for _, plr in ipairs(Players:GetPlayers()) do
	createESP(plr)
end
track(Players.PlayerAdded:Connect(createESP))
track(Players.PlayerRemoving:Connect(destroyESP))

local function hideAll(d)
	for _, o in pairs(d) do
		if o then o.Visible = false end
	end
end

local function updateESP()
	local vs = Camera.ViewportSize
	local center = vs / 2
	local bottomCenter = Vector2.new(center.X, vs.Y - 4)

	for plr, d in pairs(espData) do
		local char = plr.Character
		local head = char and char:FindFirstChild("Head")
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")

		local show = Cfg.ESP and head and hrp and hum and hum.Health > 0
		if show and Cfg.ESPTeam and plr.Team and plr.Team == LP.Team then
			show = false
		end
		if not show then
			hideAll(d)
			continue
		end

		local screen, onScreen = Camera:WorldToViewportPoint(head.Position)
		local dist = math.floor((hrp.Position - Camera.CFrame.Position).Magnitude)
		local onView = onScreen and screen.Z > 0
			and screen.X > 0 and screen.Y > 0
			and screen.X < vs.X and screen.Y < vs.Y

		if onView then
			local top = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.6, 0))
			local bottom = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 2.8, 0))
			local h = math.max(math.abs(bottom.Y - top.Y), 8)
			local w = h * 0.5
			local x = top.X - w / 2
			local y = top.Y

			if d.box then
				d.box.Visible = Cfg.ESPBox
				d.box.Position = Vector2.new(x, y)
				d.box.Size = Vector2.new(w, h)
			end
			if d.name then
				d.name.Visible = Cfg.ESPName
				d.name.Position = Vector2.new(top.X, y - 16)
				d.name.Text = plr.DisplayName
			end
			if d.dist then
				d.dist.Visible = Cfg.ESPDist
				d.dist.Position = Vector2.new(top.X, y + h + 2)
				d.dist.Text = tostring(dist) .. "m"
			end
			if d.tool then
				local tool = char:FindFirstChildOfClass("Tool")
				d.tool.Visible = Cfg.ESPTool and tool ~= nil
				if tool then
					d.tool.Position = Vector2.new(top.X, y + h + 17)
					d.tool.Text = tool.Name
				end
			end
			if d.tracer then
				d.tracer.Visible = Cfg.ESPTracer
				d.tracer.From = bottomCenter
				d.tracer.To = Vector2.new(top.X, y + h)
			end
			if d.arrow1 then d.arrow1.Visible = false end
			if d.arrow2 then d.arrow2.Visible = false
			end
		else
			if d.box then d.box.Visible = false end
			if d.name then d.name.Visible = false end
			if d.dist then d.dist.Visible = false end
			if d.tool then d.tool.Visible = false end
			if d.tracer then d.tracer.Visible = false end

			local showArrow = Cfg.ESPArrows and d.arrow1 and d.arrow2
			if not showArrow
