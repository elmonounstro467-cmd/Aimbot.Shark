local function showTab(name)
	for n, p in pairs(pages) do
		p.Visible = (n == name)
	end
	for n, b in pairs(tabBtns) do
		b.BackgroundColor3 = (n == name) and Color3.fromRGB(0, 90, 68) or BG2
		b.TextColor3 = (n == name) and TEAL or TXT
	end
